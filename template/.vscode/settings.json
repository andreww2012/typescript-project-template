{
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
  ],

  "[javascript][typescript][typescriptreact][vue][css][scss][postcss]": {
    // Note: do NOT set `editor.formatOnSaveMode` to any value with `modifications` -
    // @if prettier
    // may incorrectly run prettier with `prettier-disabled` directives
    // @endif
    // @if oxfmt
    // may incorrectly run the formatter with `prettier-ignore`/`oxfmt-ignore` directives
    // @endif
    "editor.formatOnSave": true,
    // @if prettier
    "editor.defaultFormatter": "esbenp.prettier-vscode", // cspell:disable-line
    // @endif
    // @if oxfmt
    "editor.defaultFormatter": "oxc.oxc-vscode",
    // @endif
  },

  "js/ts.tsdk.path": "node_modules/typescript/lib",
  // The same TypeScript 7 as the `ts` script
  "js/ts.experimental.useTsgo": true,
  // @if commitlint
  // Same as `header-max-length` in the commitlint config
  "git.inputValidationSubjectLength": 120,
  // @endif
  // @if cspell

  "cSpell.enabled": true,
  // @endif
}
