{
  "name": "@andreww2012/commitlint-config",
  "version": "0.0.1",
  "description": "@andreww2012's configurable commitlint config",
  "keywords": [
    "commitlint",
    "commitlint-config",
    "config",
    "conventional-commits"
  ],
  "homepage": "https://github.com/andreww2012/typescript-project-template/tree/main/packages/commitlint-config",
  "bugs": {
    "url": "https://github.com/andreww2012/typescript-project-template/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/typescript-project-template.git",
    "directory": "packages/commitlint-config"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "nr build",
    "prepublishOnly": "nr check:package",
    "check:package": "pnpm pack --out temp/package.tgz && publint temp/package.tgz --strict"
  },
  "dependencies": {
    "@commitlint/types": "21.2.3",
    "conventional-changelog-conventionalcommits": "10.4.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "cspell-lib": "10.4.0",
    "tsdown": "0.23.2",
    "utilery": "0.3.0"
  },
  "peerDependencies": {
    "cspell-lib": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "cspell-lib": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.23.1 || ^24.18.0 || >=26.4.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
