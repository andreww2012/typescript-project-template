{
  "name": "@andreww2012/typescript-project-template",
  "version": "0.6.0",
  "description": "@andreww2012's personal generic TypeScript project template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/typescript-project-template.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": "dist/cli.js",
  "files": [
    "dist/files.json",
    "dist/options.js",
    "dist/prompts.js",
    "dist/template.js"
  ],
  "scripts": {
    "build": "node scripts/snapshot.ts && tsc -p tsconfig.build.json",
    "dev": "node scripts/snapshot.ts && tsx src/cli.ts",
    "prepack": "nr build",
    "prepublishOnly": "nr check:package",
    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "pnpm self-update",
    "u:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:fix": "nr deps:audit --fix override",
    "deps:audit:fix:update": "nr deps:audit --fix update",
    "check:deps:dedupe": "pnpm dedupe --check",
    "check:deps:peers": "pnpm peers check",
    "check:spelling": "cspell --no-progress --no-summary .",
    "check:format": "oxfmt --check",
    "format": "oxfmt",
    "eslint:inspect": "eslint-config-inspector --open false",
    "eslint": "eslint --cache --config eslint.config.ts",
    "ts": "tsc --noEmit",
    "ts6": "tsc6 --noEmit",
    "knip:main": "knip --no-progress",
    "knip:cycles": "knip --no-progress --cycles --reporter cycles",
    "knip": "nr \"/^knip:.+$/\"",
    "check": "nr \"/^(knip|check:(spelling|format)|ts|eslint)$/\"",
    "check:deps": "nr \"/^(deps:audit|check:deps:peers)$/\"",
    "check:deps:strict": "nr \"/^(deps:audit|check:deps:(dedupe|peers))$/\"",
    "check:package": "pnpm pack --out temp/package.tgz && publint temp/package.tgz --strict",
    "check:fix": "nr format && nr eslint --fix && nr format",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test": "nr check:deps && nr check && nr test:vitest",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish"
  },
  "dependencies": {
    "@andreww2012/ai-guidelines": "catalog:",
    "@clack/prompts": "catalog:",
    "bingo": "catalog:",
    "utilery": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@andreww2012/commitlint-config": "workspace:*",
    "@andreww2012/npm-check-updates-config": "workspace:*",
    "@antfu/ni": "catalog:dev",
    "@changesets/changelog-github": "catalog:dev",
    "@changesets/cli": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@eslint/config-inspector": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/eslint-plugin": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "actions-up": "catalog:dev",
    "cspell": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-un": "catalog:dev",
    "eslint-plugin-github-action": "catalog:dev",
    "eslint-plugin-sentences-per-line": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:dev",
    "knip": "catalog:dev",
    "lefthook": "catalog:dev",
    "npm-check-updates": "catalog:dev",
    "oxfmt": "catalog:dev",
    "publint": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "typescript7": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": "^24.18.0 || >=26.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0"
    }
  }
}