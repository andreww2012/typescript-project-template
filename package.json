{
  "name": "@andreww2012/typescript-project-template",
  "version": "0.1.0",
  "description": "@andreww2012's personal generic TypeScript project template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/typescript-project-template.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": "dist/cli.js",
  "files": [
    "dist/files.json",
    "dist/options.js",
    "dist/prompts.js",
    "dist/template.js"
  ],
  "scripts": {
    "build": "node scripts/snapshot.ts && tsc -p tsconfig.build.json",
    "dev": "node scripts/snapshot.ts && tsx src/cli.ts",
    "prepack": "nr build",
    "prepublishOnly": "nr check:package",
    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "ncu --dep packageManager",
    "u:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:fix": "nr deps:audit --fix override",
    "deps:audit:fix:update": "nr deps:audit --fix update",
    "check:deps:dedupe": "pnpm dedupe --check",
    "check:deps:peers": "pnpm peers check",
    "check:spelling": "cspell --no-progress --no-summary .",
    "check:format": "prettier --check . --log-level warn",
    "format": "prettier --write . --log-level warn",
    "eslint:inspect": "eslint-config-inspector --open false",
    "eslint": "eslint --cache --config eslint.config.ts",
    "ts": "tsc --noEmit",
    "ts6": "tsc6 --noEmit",
    "knip:main": "knip --no-progress",
    "knip:cycles": "knip --no-progress --cycles --reporter cycles",
    "knip": "nr \"/^knip:.+$/\"",
    "check": "nr \"/^(knip|check:(spelling|format)|ts|eslint)$/\"",
    "check:deps": "nr \"/^(deps:audit|check:deps:peers)$/\"",
    "check:deps:strict": "nr \"/^(deps:audit|check:deps:(dedupe|peers))$/\"",
    "check:package": "pnpm pack --out temp/package.tgz && publint temp/package.tgz --strict",
    "check:fix": "nr format && nr eslint --fix && nr format",
    "test": "nr check:deps && nr check",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish"
  },
  "dependencies": {
    "@andreww2012/ai-guidelines": "^0.2.0",
    "@clack/prompts": "1.8.1",
    "bingo": "0.13.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@antfu/ni": "30.6.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/config-inspector": "3.5.0",
    "@types/node": "24.19.1",
    "actions-up": "1.21.0",
    "cspell": "10.3.6",
    "eslint": "10.11.0",
    "eslint-config-un": "1.0.0-rc.3",
    "eslint-plugin-github-action": "0.4.0",
    "eslint-plugin-sentences-per-line": "0.1.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "npm-check-updates": "23.1.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "verkit": "0.5.0"
  },
  "engines": {
    "node": "^24.18.0 || >=26.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2"
    }
  }
}